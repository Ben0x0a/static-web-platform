{
  "name": "static-web-platform",
  "version": "1.1.0",
  "private": true,
  "description": "Shared base of static web apps: consent-gated network, local storage, single-file download + update check, PWA install/offline, build (swp) and verification gate.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "swp": "bin/swp"
  },
  "files": [
    "src",
    "tools/swp_tools/*.py",
    "bin",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "esbuild": ">=0.28.0 <0.29.0",
    "typescript": ">=6.0.0 <8.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "node --test \"tests/ts/*.test.ts\" && python3 -m unittest discover -s tests/py -t tests/py"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild": false
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  }
}
